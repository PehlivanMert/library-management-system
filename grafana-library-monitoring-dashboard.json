{
  "dashboard": {
    "id": null,
    "title": "📚 Library Management System - Real-time Monitoring Dashboard",
    "tags": ["library", "monitoring", "spring-boot"],
    "timezone": "browser",
    "time": {
      "from": "now-15m",
      "to": "now"
    },
    "refresh": "10s",
    "panels": [
      {
        "id": 1,
        "title": "🌐 HTTP Request Rate",
        "type": "timeseries",
        "targets": [
          {
            "expr": "rate(http_server_requests_seconds_count[5m])",
            "legendFormat": "{{method}} {{uri}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "fillOpacity": 10
            },
            "unit": "reqps"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 0
        }
      },
      {
        "id": 2,
        "title": "📚 Total Books",
        "type": "stat",
        "targets": [
          {
            "expr": "library_books_total"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "unit": "short"
          }
        },
        "gridPos": {
          "h": 4,
          "w": 6,
          "x": 0,
          "y": 8
        }
      },
      {
        "id": 3,
        "title": "👥 Total Users",
        "type": "stat",
        "targets": [
          {
            "expr": "library_users_total"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "unit": "short"
          }
        },
        "gridPos": {
          "h": 4,
          "w": 6,
          "x": 6,
          "y": 8
        }
      },
      {
        "id": 4,
        "title": "👨‍💼 Total Authors",
        "type": "stat",
        "targets": [
          {
            "expr": "library_authors_total"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "unit": "short"
          }
        },
        "gridPos": {
          "h": 4,
          "w": 6,
          "x": 12,
          "y": 8
        }
      },
      {
        "id": 5,
        "title": "📋 Total Loans",
        "type": "stat",
        "targets": [
          {
            "expr": "library_loans_total"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "unit": "short"
          }
        },
        "gridPos": {
          "h": 4,
          "w": 6,
          "x": 18,
          "y": 8
        }
      },
      {
        "id": 6,
        "title": "📚 Book Statistics",
        "type": "timeseries",
        "targets": [
          {
            "expr": "library_books_total",
            "legendFormat": "Total Books"
          },
          {
            "expr": "library_books_category_total",
            "legendFormat": "Books by Category"
          },
          {
            "expr": "library_books_stock_change_total",
            "legendFormat": "Stock Changes"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "fillOpacity": 10
            },
            "unit": "short"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 12
        }
      },
      {
        "id": 7,
        "title": "👥 User Statistics",
        "type": "timeseries",
        "targets": [
          {
            "expr": "library_users_total",
            "legendFormat": "Total Users"
          },
          {
            "expr": "library_users_active_total",
            "legendFormat": "Active Users"
          },
          {
            "expr": "library_users_new_total",
            "legendFormat": "New Users"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "fillOpacity": 10
            },
            "unit": "short"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 12
        }
      },
      {
        "id": 8,
        "title": "👨‍💼 Author Statistics",
        "type": "timeseries",
        "targets": [
          {
            "expr": "library_authors_total",
            "legendFormat": "Total Authors"
          },
          {
            "expr": "library_authors_books_per_author_total",
            "legendFormat": "Books per Author"
          },
          {
            "expr": "library_authors_new_total",
            "legendFormat": "New Authors"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "fillOpacity": 10
            },
            "unit": "short"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 20
        }
      },
      {
        "id": 9,
        "title": "📋 Loan Statistics",
        "type": "timeseries",
        "targets": [
          {
            "expr": "library_loans_total",
            "legendFormat": "Total Loans"
          },
          {
            "expr": "library_loans_overdue_total",
            "legendFormat": "Overdue Loans"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "fillOpacity": 10
            },
            "unit": "short"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 20
        }
      },
      {
        "id": 10,
        "title": "📧 Email Statistics",
        "type": "timeseries",
        "targets": [
          {
            "expr": "library_emails_welcome_sent_total",
            "legendFormat": "Welcome Emails"
          },
          {
            "expr": "library_emails_loan_sent_total",
            "legendFormat": "Loan Notifications"
          },
          {
            "expr": "library_emails_overdue_sent_total",
            "legendFormat": "Overdue Notifications"
          },
          {
            "expr": "library_emails_errors_total",
            "legendFormat": "Email Errors"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "fillOpacity": 10
            },
            "unit": "short"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 28
        }
      },
      {
        "id": 11,
        "title": "🔔 Notification Statistics",
        "type": "timeseries",
        "targets": [
          {
            "expr": "library_notifications_received_total",
            "legendFormat": "Notifications Received"
          },
          {
            "expr": "library_notifications_processed_total",
            "legendFormat": "Notifications Processed"
          },
          {
            "expr": "library_notifications_errors_total",
            "legendFormat": "Notification Errors"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "fillOpacity": 10
            },
            "unit": "short"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 28
        }
      },
      {
        "id": 12,
        "title": "⏱️ HTTP Response Time",
        "type": "timeseries",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(http_server_requests_seconds_bucket[5m]))",
            "legendFormat": "95th Percentile"
          },
          {
            "expr": "histogram_quantile(0.50, rate(http_server_requests_seconds_bucket[5m]))",
            "legendFormat": "50th Percentile"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "fillOpacity": 10
            },
            "unit": "s"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 36
        }
      },
      {
        "id": 13,
        "title": "📊 System Overview",
        "type": "stat",
        "targets": [
          {
            "expr": "up",
            "legendFormat": "System Status"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {
                  "color": "red",
                  "value": null
                },
                {
                  "color": "green",
                  "value": 1
                }
              ]
            },
            "unit": "short"
          }
        },
        "gridPos": {
          "h": 4,
          "w": 12,
          "x": 12,
          "y": 36
        }
      }
    ]
  },
  "folderId": 0,
  "overwrite": true
}
